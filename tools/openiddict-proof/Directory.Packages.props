<Project>
  <!-- The proof owns its dependency graph; production versions stay unchanged. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.8.0" />
    <PackageVersion Include="OpenIddict.Validation.AspNetCore" Version="7.8.0" />
    <PackageVersion Include="OpenIddict.Validation.ServerIntegration" Version="7.8.0" />
    <PackageVersion Include="OpenIddict.EntityFrameworkCore" Version="7.8.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>
</Project>
