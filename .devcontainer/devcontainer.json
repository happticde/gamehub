{
    "name": "Game Lib Backend",
    // .NET, Node.js, and Go are installed by the Dockerfile so plain Docker Compose
    // and VS Code Dev Containers use the same toolchain.
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "forwardPorts": [3005],
    "portsAttributes": {
        "3005": {
            "label": "Next.js Frontend",
            "onAutoForward": "notify"
        }
    }
}
