# GameHub Environment Variables
# Copy this file to .env and fill in your secrets.
# Do NOT commit the .env file to version control.

# Authentication (Empty = auth disabled)
GAMEHUB_API_KEY=

# IGDB API Credentials (Get from https://dev.twitch.tv/console)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Database Configuration (Core Service)
CORE_DB_PROVIDER=Postgres
POSTGRES_DB=gamehub_core
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
