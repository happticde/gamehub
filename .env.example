# GameHub Environment Variables
# Copy this file to .env and fill in your secrets.
# Do NOT commit the .env file to version control.

# Authentication (API key empty = legacy auth-disabled mode; JWT key empty = JWT disabled)
GAMEHUB_API_KEY=
GAMEHUB_TENANT_ID=00000000-0000-0000-0000-000000000001
# Use a randomly generated secret containing at least 32 UTF-8 bytes.
GAMEHUB_JWT_SIGNING_KEY=

# IGDB API Credentials (Get from https://dev.twitch.tv/console)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Database Configuration (Core Service)
CORE_DB_PROVIDER=Postgres
POSTGRES_DB=gamehub_core
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
