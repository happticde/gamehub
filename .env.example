# GameHub Environment Variables
# Copy this file to .env and fill in your secrets.
# Do NOT commit the .env file to version control.

# Frontend networking
# Default: accessible only from this host. For a reverse proxy on another host, use
# a reserved private/VPN IP of the GameHub host and restrict port 3000 to the proxy.
GAMEHUB_FRONTEND_BIND_IP=127.0.0.1
# Exact browser-facing origin. For HTTPS deployments, replace with your domain,
# for example https://games.example.com; a mismatch blocks browser writes.
GAMEHUB_PUBLIC_ORIGIN=http://localhost:3000

# Authentication (Compose requires independent API/JWT keys; empty values do not disable auth)
# Generate 32-512 printable non-space ASCII characters.
GAMEHUB_API_KEY=
GAMEHUB_TENANT_ID=00000000-0000-0000-0000-000000000001
# Dedicated Core-to-Ingest key. Do not reuse GAMEHUB_API_KEY.
GAMEHUB_INGEST_SERVICE_KEY=
# Base64-encoded 32-byte AES key, for example: openssl rand -base64 32
GAMEHUB_CREDENTIAL_KEY_VERSION=1
GAMEHUB_CREDENTIAL_KEY_1=
# Use a randomly generated secret containing at least 32 UTF-8 bytes.
GAMEHUB_JWT_SIGNING_KEY=
# Rotating refresh sessions expire absolutely after this many days (1-90).
GAMEHUB_JWT_REFRESH_TOKEN_DAYS=30
# Keep login enabled; configure the JWT key and bootstrap an owner before signing in.
GAMEHUB_FRONTEND_AUTH_ENABLED=true
# Set true only when the frontend is served to browsers over HTTPS.
GAMEHUB_AUTH_COOKIE_SECURE=false

# IGDB API Credentials (Get from https://dev.twitch.tv/console)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Database Configuration (Core Service)
CORE_DB_PROVIDER=Postgres
POSTGRES_DB=gamehub_core
POSTGRES_USER=postgres
# Required: provide a strong password before starting Compose.
POSTGRES_PASSWORD=
