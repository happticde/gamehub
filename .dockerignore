# Root .dockerignore — applies to Core, Ingest, and MCP image builds
# (.NET images use the repo root as their build context)

# Version control
.git
.github

# IDE / editor
.vscode
.devcontainer
*.code-workspace
.DS_Store

# Documentation
docs
README.md
AGENTS.md

# Frontend (not needed for .NET service builds)
frontend/

# Test projects
tests/

# SQLite artefacts
*.db
*.db-shm
*.db-wal

# .NET build output (built inside Docker)
**/bin/
**/obj/
# Also exclude malformed host artefact directories such as a literal `bin\Debug`
# name. On macOS the backslash is part of the directory name; once copied into
# Linux it can break MSBuild's default glob expansion (for example **/*.resx).
**/[Bb]in*/
**/[Oo]bj*/

# Environment files (secrets should be passed via env vars at runtime)
.env
.env.*
**/.env
**/.env.*
