<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Allow stdout to be used cleanly for MCP stdio transport.
      All application logs must go to stderr so they don't corrupt the JSON-RPC stream.
    -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core MCP SDK with DI/hosting extensions -->
    <PackageReference Include="ModelContextProtocol" />
    <!-- Generic host for DI, configuration, and lifetime management -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Typed HttpClient for Core API calls -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
