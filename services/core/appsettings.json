{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=/app/data/core.db",
    "Postgres": ""
  },
  "Services": {
    "IngestUrl": "http://localhost:5000",
    "IngestServiceKey": ""
  },
  "Authentication": {
    "ApiKey": "",
    "TenantId": "00000000-0000-0000-0000-000000000001",
    "Jwt": {
      "SigningKey": "",
      "Issuer": "GameHub",
      "Audience": "GameHub.Clients",
      "LifetimeMinutes": 60,
      "RefreshTokenLifetimeDays": 30
    },
    "Frontend": {
      "Enabled": false,
      "SecureCookies": false,
      "MultiUserEnabled": false
    },
    "Oidc": {
      "ProvisioningMode": "Disabled"
    }
  },
  "MultiUser": {
    "Enabled": false
  },
  "Igdb": {
    "ClientId": "",
    "ClientSecret": "",
    "EnableBackgroundEnrichment": true,
    "BatchSize": 4,
    "DelayBetweenBatchesMs": 1500
  },
  "ProductCatalog": {
    "Provider": "None",
    "TimeoutMilliseconds": 1500
  },
  "Sync": {
    "EnableScheduler": false,
    "IntervalMinutes": 360,
    "ProviderFreshnessMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
