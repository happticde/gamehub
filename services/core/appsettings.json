{
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=/app/data/core.db",
    "Postgres": "Host=localhost;Port=5432;Database=gamehub_core;Username=postgres;Password=password"
  },
  "Authentication": {
    "ApiKey": "",
    "TenantId": "00000000-0000-0000-0000-000000000001",
    "Jwt": {
      "SigningKey": "",
      "Issuer": "GameHub",
      "Audience": "GameHub.Clients",
      "LifetimeMinutes": 60
    }
  },
  "Igdb": {
    "ClientId": "",
    "ClientSecret": "",
    "EnableBackgroundEnrichment": true,
    "BatchSize": 4,
    "DelayBetweenBatchesMs": 1500
  },
  "Sync": {
    "EnableScheduler": false,
    "IntervalMinutes": 360
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
