{
  "name": "gamehub-documentation",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "engines": { "node": ">=24" },
  "scripts": {
    "prepare-docs": "node scripts/prepare.mjs",
    "start": "npm run prepare-docs && docusaurus start --host 0.0.0.0",
    "build": "npm run prepare-docs && docusaurus build && node scripts/verify-build.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build"
  },
  "overrides": {
    "katex": "0.19.0",
    "postcss-selector-parser": "7.1.6",
    "serialize-javascript": "7.0.5",
    "tinypool": "2.1.2",
    "sockjs": { "uuid": "11.1.1" }
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "@mermaid-js/layout-elk": "1.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
